import csv
import re
from difflib import SequenceMatcher
from pathlib import Path
from typing import Dict, List, Optional, Tuple


# ============================================================
# CONFIGURATION
# ============================================================

SERVICE_FILE = Path(__file__).resolve()

# Try all likely locations for the Indian medicine CSV.
POSSIBLE_DATA_FILES = [
    SERVICE_FILE.parents[2] / "data" / "updated_indian_medicine_data.csv",
    SERVICE_FILE.parents[3] / "data" / "updated_indian_medicine_data.csv",

    SERVICE_FILE.parents[2] / "ml" / "data" / "updated_indian_medicine_data.csv",
    SERVICE_FILE.parents[3] / "ml" / "data" / "updated_indian_medicine_data.csv",

    SERVICE_FILE.parents[2] / "updated_indian_medicine_data.csv",
    SERVICE_FILE.parents[3] / "updated_indian_medicine_data.csv",

    SERVICE_FILE.parents[2] / "app" / "data" / "updated_indian_medicine_data.csv",
    SERVICE_FILE.parents[3] / "app" / "data" / "updated_indian_medicine_data.csv",
]


# ============================================================
# CACHE
# ============================================================

_MEDICINE_ROWS: Optional[List[Dict[str, str]]] = None
_DATA_FILE: Optional[Path] = None


# ============================================================
# TEXT NORMALIZATION
# ============================================================

def normalize_text(value: str) -> str:
    """
    Normalize medicine text for searching.
    """

    if value is None:
        return ""

    value = str(value).lower().strip()

    # Replace common separators with spaces.
    value = value.replace("_", " ")
    value = value.replace("/", " ")
    value = value.replace("\\", " ")
    value = value.replace(",", " ")
    value = value.replace("(", " ")
    value = value.replace(")", " ")
    value = value.replace("[", " ")
    value = value.replace("]", " ")

    # Keep letters, numbers, +, %, ., -, and spaces.
    value = re.sub(
        r"[^a-z0-9+/%.\- ]+",
        " ",
        value,
    )

    # Normalize multiple spaces.
    value = re.sub(r"\s+", " ", value).strip()

    return value


def compact_text(value: str) -> str:
    """
    Remove spaces and punctuation.

    Example:
        Dolo 650
        Dolo-650
        Dolo650

    all become:

        dolo650
    """

    return re.sub(
        r"[^a-z0-9]+",
        "",
        normalize_text(value),
    )


# ============================================================
# MEDICINE ALIASES
# ============================================================

MEDICINE_ALIASES = {
    "dolo 650": [
        "dolo 650",
        "dolo650",
        "dolo 650mg",
        "dolo650mg",
        "paracetamol 650",
        "paracetamol 650mg",
        "acetaminophen 650",
        "acetaminophen 650mg",
    ],

    "dolo650": [
        "dolo 650",
        "dolo650",
        "dolo 650mg",
        "dolo650mg",
        "paracetamol 650",
        "paracetamol 650mg",
        "acetaminophen 650",
        "acetaminophen 650mg",
    ],

    "paracetamol": [
        "paracetamol",
        "acetaminophen",
    ],

    "acetaminophen": [
        "acetaminophen",
        "paracetamol",
    ],

    "calpol": [
        "calpol",
        "paracetamol",
    ],

    "crocin": [
        "crocin",
        "paracetamol",
    ],
}


# ============================================================
# CSV FILE FINDER
# ============================================================

def _find_data_file() -> Optional[Path]:
    """
    Find the medicine CSV from several possible project locations.
    """

    global _DATA_FILE

    if _DATA_FILE is not None and _DATA_FILE.exists():
        return _DATA_FILE

    for path in POSSIBLE_DATA_FILES:
        if path.exists() and path.is_file():
            _DATA_FILE = path

            print()
            print("=" * 70)
            print("Smart HealthGuard - Indian Medicine Dataset")
            print("=" * 70)
            print(f"Dataset found:")
            print(path)
            print("=" * 70)
            print()

            return path

    # Last fallback:
    # Search the project directory for the exact filename.
    project_roots = [
        SERVICE_FILE.parents[3],
        SERVICE_FILE.parents[4],
    ]

    for root in project_roots:
        if not root.exists():
            continue

        try:
            matches = list(
                root.rglob("updated_indian_medicine_data.csv")
            )

            if matches:
                _DATA_FILE = matches[0]

                print()
                print("=" * 70)
                print("Smart HealthGuard - Indian Medicine Dataset")
                print("=" * 70)
                print("Dataset found using fallback search:")
                print(_DATA_FILE)
                print("=" * 70)
                print()

                return _DATA_FILE

        except Exception as error:
            print(
                "Dataset fallback search failed:",
                error,
            )

    print()
    print("=" * 70)
    print("WARNING: Indian medicine dataset was NOT found.")
    print("=" * 70)

    for path in POSSIBLE_DATA_FILES:
        print("Checked:", path)

    print("=" * 70)
    print()

    return None


# ============================================================
# LOAD CSV
# ============================================================

def _load_medicine_rows() -> List[Dict[str, str]]:
    """
    Load the CSV only once and keep it in memory.

    This makes later searches extremely fast.
    """

    global _MEDICINE_ROWS

    if _MEDICINE_ROWS is not None:
        return _MEDICINE_ROWS

    data_file = _find_data_file()

    if data_file is None:
        _MEDICINE_ROWS = []
        return _MEDICINE_ROWS

    rows: List[Dict[str, str]] = []

    try:
        with data_file.open(
            "r",
            encoding="utf-8-sig",
            newline="",
        ) as file:

            reader = csv.DictReader(file)

            for row in reader:
                if not row:
                    continue

                cleaned_row = {
                    str(key).strip(): (
                        "" if value is None else str(value).strip()
                    )
                    for key, value in row.items()
                    if key is not None
                }

                rows.append(cleaned_row)

        _MEDICINE_ROWS = rows

        print(
            f"Indian medicine dataset loaded: "
            f"{len(_MEDICINE_ROWS)} rows"
        )

        return _MEDICINE_ROWS

    except Exception as error:

        print(
            "Failed to load Indian medicine dataset:",
            error,
        )

        _MEDICINE_ROWS = []

        return _MEDICINE_ROWS


# ============================================================
# CSV COLUMN HELPERS
# ============================================================

def _get_value(
    row: Dict[str, str],
    possible_names: List[str],
) -> str:

    normalized_columns = {
        normalize_text(key): value
        for key, value in row.items()
    }

    for name in possible_names:

        normalized_name = normalize_text(name)

        if normalized_name in normalized_columns:
            return normalized_columns[normalized_name] or ""

    return ""


def _medicine_name(row: Dict[str, str]) -> str:
    return _get_value(
        row,
        [
            "name",
            "medicine_name",
            "brand_name",
            "product_name",
            "drug_name",
        ],
    )


def _composition_1(row: Dict[str, str]) -> str:
    return _get_value(
        row,
        [
            "short_composition1",
            "short_composition_1",
            "composition",
            "composition1",
            "salt",
            "generic_name",
        ],
    )


def _composition_2(row: Dict[str, str]) -> str:
    return _get_value(
        row,
        [
            "short_composition2",
            "short_composition_2",
            "composition2",
            "composition_2",
        ],
    )


def _manufacturer(row: Dict[str, str]) -> str:
    return _get_value(
        row,
        [
            "manufacturer_name",
            "manufacturer",
            "company",
            "company_name",
        ],
    )


# ============================================================
# ALIAS GENERATOR
# ============================================================

def _get_aliases(query: str) -> List[str]:

    normalized_query = normalize_text(query)
    compact_query = compact_text(query)

    aliases = [
        normalized_query,
        compact_query,
    ]

    if normalized_query in MEDICINE_ALIASES:
        aliases.extend(
            MEDICINE_ALIASES[normalized_query]
        )

    if compact_query in MEDICINE_ALIASES:
        aliases.extend(
            MEDICINE_ALIASES[compact_query]
        )

    # Special Dolo handling.
    if "dolo" in normalized_query and "650" in normalized_query:

        aliases.extend(
            [
                "dolo 650",
                "dolo650",
                "dolo 650mg",
                "dolo650mg",
                "paracetamol 650",
                "paracetamol 650mg",
            ]
        )

    # Special Paracetamol handling.
    if "paracetamol" in normalized_query:

        aliases.extend(
            [
                "paracetamol",
                "acetaminophen",
            ]
        )

    # Remove duplicates while preserving order.
    unique_aliases = []

    for alias in aliases:

        alias = normalize_text(alias)

        if alias and alias not in unique_aliases:
            unique_aliases.append(alias)

    return unique_aliases


# ============================================================
# EXACT MATCH CHECK
# ============================================================

def _exact_match_score(
    query: str,
    row: Dict[str, str],
) -> int:

    query_normalized = normalize_text(query)
    query_compact = compact_text(query)

    name = normalize_text(_medicine_name(row))
    composition_1 = normalize_text(_composition_1(row))
    composition_2 = normalize_text(_composition_2(row))

    name_compact = compact_text(name)
    composition_1_compact = compact_text(composition_1)
    composition_2_compact = compact_text(composition_2)

    aliases = _get_aliases(query)

    best_score = 0

    for alias in aliases:

        alias_normalized = normalize_text(alias)
        alias_compact = compact_text(alias)

        if not alias_normalized:
            continue

        # Exact medicine name.
        if name == alias_normalized:
            best_score = max(best_score, 1000)

        # Dolo 650mg Tablet should match Dolo 650.
        if alias_compact and alias_compact == name_compact:
            best_score = max(best_score, 1000)

        # Name contains the requested medicine.
        if (
            alias_normalized in name
            and len(alias_normalized) >= 4
        ):
            best_score = max(best_score, 900)

        if (
            alias_compact in name_compact
            and len(alias_compact) >= 4
        ):
            best_score = max(best_score, 900)

        # Composition match.
        if (
            alias_normalized in composition_1
            and len(alias_normalized) >= 4
        ):
            best_score = max(best_score, 850)

        if (
            alias_normalized in composition_2
            and len(alias_normalized) >= 4
        ):
            best_score = max(best_score, 820)

        if (
            alias_compact
            and alias_compact in composition_1_compact
            and len(alias_compact) >= 4
        ):
            best_score = max(best_score, 850)

        if (
            alias_compact
            and alias_compact in composition_2_compact
            and len(alias_compact) >= 4
        ):
            best_score = max(best_score, 820)

    # Strong special case:
    # Searching "Dolo 650" should find Paracetamol 650 mg.
    if (
        "dolo" in query_normalized
        and "650" in query_normalized
    ):

        if "paracetamol" in composition_1:

            if "650" in composition_1:
                best_score = max(best_score, 1100)

            elif "650" in name:
                best_score = max(best_score, 1100)

        if "paracetamol" in composition_2:

            if "650" in composition_2:
                best_score = max(best_score, 1050)

    return best_score


# ============================================================
# FUZZY SCORE
# ============================================================

def _fuzzy_score(
    query: str,
    row: Dict[str, str],
) -> int:

    query_normalized = normalize_text(query)

    if not query_normalized:
        return 0

    name = normalize_text(_medicine_name(row))
    composition_1 = normalize_text(_composition_1(row))
    composition_2 = normalize_text(_composition_2(row))

    score = 0

    if name:
        similarity = SequenceMatcher(
            None,
            query_normalized,
            name,
        ).ratio()

        score = max(
            score,
            int(similarity * 500),
        )

    if composition_1:

        similarity = SequenceMatcher(
            None,
            query_normalized,
            composition_1,
        ).ratio()

        score = max(
            score,
            int(similarity * 400),
        )

    if composition_2:

        similarity = SequenceMatcher(
            None,
            query_normalized,
            composition_2,
        ).ratio()

        score = max(
            score,
            int(similarity * 350),
        )

    return score


# ============================================================
# SEARCH MEDICINES
# ============================================================

def search_indian_medicines(
    medicine_name: str,
    limit: int = 10,
) -> List[Dict[str, object]]:

    query = normalize_text(medicine_name)

    print(
        f"Indian medicine search: '{medicine_name}'"
    )

    if not query:
        return []

    rows = _load_medicine_rows()

    if not rows:
        print(
            "Indian medicine search: dataset is empty."
        )
        return []

    # --------------------------------------------------------
    # PASS 1
    # Strong/exact matches.
    # --------------------------------------------------------

    strong_results: List[Tuple[int, Dict[str, str]]] = []

    for row in rows:

        score = _exact_match_score(
            query,
            row,
        )

        if score >= 800:

            strong_results.append(
                (
                    score,
                    row,
                )
            )

    # Strong matches are enough.
    if strong_results:

        strong_results.sort(
            key=lambda item: item[0],
            reverse=True,
        )

        results = []

        seen = set()

        for score, row in strong_results:

            name = _medicine_name(row)

            unique_key = (
                compact_text(name),
                compact_text(_composition_1(row)),
            )

            if unique_key in seen:
                continue

            seen.add(unique_key)

            results.append(
                {
                    "score": score,
                    "medicine": row,
                }
            )

            if len(results) >= limit:
                break

        print(
            f"Indian medicine search: "
            f"{len(results)} strong result(s)"
        )

        if results:

            first = results[0]["medicine"]

            print(
                "Top match:",
                _medicine_name(first),
                "|",
                _composition_1(first),
                "|",
                _manufacturer(first),
            )

        return results

    # --------------------------------------------------------
    # PASS 2
    # Candidate filtering before fuzzy matching.
    # This avoids running SequenceMatcher against
    # every row in the CSV.
    # --------------------------------------------------------

    query_tokens = [
        token
        for token in query.split()
        if len(token) >= 2
    ]

    candidates: List[Dict[str, str]] = []

    for row in rows:

        searchable_text = " ".join(
            [
                normalize_text(_medicine_name(row)),
                normalize_text(_composition_1(row)),
                normalize_text(_composition_2(row)),
                normalize_text(_manufacturer(row)),
            ]
        )

        if not searchable_text:
            continue

        if any(
            token in searchable_text
            for token in query_tokens
        ):
            candidates.append(row)

        if len(candidates) >= 300:
            break

    # --------------------------------------------------------
    # PASS 3
    # Fuzzy matching only on relevant candidates.
    # --------------------------------------------------------

    scored_results: List[
        Tuple[int, Dict[str, str]]
    ] = []

    for row in candidates:

        exact_score = _exact_match_score(
            query,
            row,
        )

        fuzzy_score = _fuzzy_score(
            query,
            row,
        )

        total_score = max(
            exact_score,
            fuzzy_score,
        )

        if total_score >= 150:

            scored_results.append(
                (
                    total_score,
                    row,
                )
            )

    scored_results.sort(
        key=lambda item: item[0],
        reverse=True,
    )

    results = []

    seen = set()

    for score, row in scored_results:

        name = _medicine_name(row)

        unique_key = (
            compact_text(name),
            compact_text(_composition_1(row)),
        )

        if unique_key in seen:
            continue

        seen.add(unique_key)

        results.append(
            {
                "score": score,
                "medicine": row,
            }
        )

        if len(results) >= limit:
            break

    print(
        f"Indian medicine search: "
        f"{len(results)} result(s)"
    )

    if results:

        first = results[0]["medicine"]

        print(
            "Top match:",
            _medicine_name(first),
            "|",
            _composition_1(first),
            "|",
            _manufacturer(first),
        )

    else:

        print(
            f"No Indian medicine result found "
            f"for '{medicine_name}'."
        )

    return results


# ============================================================
# BUILD MEDICINE PROFILE
# ============================================================

def build_indian_medicine_profile(
    row: Dict[str, str],
) -> Dict[str, object]:

    return {
        "brand_name": _medicine_name(row),

        "generic_name": _composition_1(row),

        "composition_2": _composition_2(row),

        "manufacturer": _manufacturer(row),

        "medicine_type": _get_value(
            row,
            [
                "type",
                "medicine_type",
                "drug_type",
            ],
        ),

        "pack_size": _get_value(
            row,
            [
                "pack_size_label",
                "pack_size",
                "packsize",
                "pack",
            ],
        ),

        "price": _get_value(
            row,
            [
                "price(₹)",
                "price",
                "mrp",
                "price_inr",
            ],
        ),

        "is_discontinued": _get_value(
            row,
            [
                "Is_discontinued",
                "is_discontinued",
                "discontinued",
            ],
        ),

        "medicine_description": _get_value(
            row,
            [
                "medicine_desc",
                "medicine_description",
                "description",
            ],
        ),

        "side_effects": _get_value(
            row,
            [
                "side_effects",
                "side_effect",
                "adverse_effects",
            ],
        ),

        "drug_interactions": _get_value(
            row,
            [
                "drug_interactions",
                "drug_interaction",
                "interactions",
            ],
        ),

        "source": "Indian Medicine Dataset",
    }


# ============================================================
# GET BEST MEDICINE
# ============================================================

def get_best_indian_medicine(
    medicine_name: str,
) -> Optional[Dict[str, object]]:

    results = search_indian_medicines(
        medicine_name,
        limit=10,
    )

    if not results:
        return None

    best_result = results[0]

    row = best_result["medicine"]

    return build_indian_medicine_profile(row)


# ============================================================
# CACHE RESET
# ============================================================

def reload_indian_medicine_dataset() -> None:

    global _MEDICINE_ROWS
    global _DATA_FILE

    _MEDICINE_ROWS = None
    _DATA_FILE = None

    print(
        "Indian medicine dataset cache cleared."
    )


